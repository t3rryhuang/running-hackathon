# CheckIn configuration. Copy to .env and fill in. NEVER commit the real .env.

# --- Twilio (SMS; the number itself is attached to the ElevenLabs agent) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_NUMBER=+441234567890
# Optional: route REST calls through a non-global processing region. Ireland is
# TWILIO_REGION=ie1 (edge inferred as dublin) and needs ie1-scoped credentials.
TWILIO_REGION=
TWILIO_EDGE=

# --- ElevenLabs (outbound voice agent; tool webhooks call back into this service) ---
ELEVENLABS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ELEVENLABS_AGENT_ID=agent_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
ELEVENLABS_PHONE_ID=phnum_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Signing secret for post-call transcript deliveries to /webhooks/elevenlabs.
# Unset means every delivery is rejected.
ELEVENLABS_WEBHOOK_SECRET=wsec_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Anthropic (SMS brain) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# Optional override, defaults to claude-sonnet-5
ANTHROPIC_MODEL=claude-sonnet-5

# --- Optional: live event feed (CSV or JSON, same columns as events_live.csv) ---
EVENTS_FEED_URL=

# --- Optional: warn-don't-crash if unset ---
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxx
GCAL_ICS_URL=https://calendar.google.com/calendar/ical/you%40example.com/private-xxxx/basic.ics

# --- Shared secret required on every /tools/* webhook (X-Webhook-Secret) ---
TOOL_WEBHOOK_SECRET=change-me

# --- Runtime ---
# Postgres is used when DATABASE_URL is set; otherwise the SQLite file below.
# Must be exported to the service process, not merely present in the env file.
DATABASE_URL=postgres://runhack:password@127.0.0.1:5433/runhack?sslmode=disable
DATABASE_PATH=./data.db
PORT=8090
